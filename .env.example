# Set LLM_PROVIDER to "anthropic" or "openai" or "huggingface"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514  #   OpenAI:    gpt-4o | HuggingFace: Qwen/Qwen2.5-7B-Instruct
OVERALL_SCORING_LLM_MAX_TOKENS=4096
LLM_JSON_PARSE_RETRIES=1
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0
TOKEN_USAGE_LOG_PATH=logs/token_usage.log
TOKEN_USAGE_LOG_MAX_BYTES=10485760
TOKEN_USAGE_LOG_BACKUP_COUNT=5

ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
HF_TOKEN=your-huggingface-token-here

# Dynamics CRM leads validation (Dataverse TDS/SQL, OAuth client credentials)
CRM_LEADS_SERVER=org.crm4.dynamics.com,5558
CRM_LEADS_TABLE=dbo.lead
CRM_LEADS_MAX_RETRIES=4
CRM_LEADS_RETRY_DELAY_SECONDS=1
CRM_App_Name=your-azure-app-registration-name
CRM_Tenant_Id=your-azure-tenant-id
CRM_LEAD_CLIENT_ID=your-azure-application-client-id
CRM_Secret_ID=your-client-secret-record-id
CLIENT_SECRET=your-client-secret-value
