# Set LLM_PROVIDER to "anthropic" or "openai" or "huggingface"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514  #   OpenAI:    gpt-4o | HuggingFace: Qwen/Qwen2.5-7B-Instruct
OVERALL_SCORING_LLM_MAX_TOKENS=4096
LLM_JSON_PARSE_RETRIES=1
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0
NODE_CONSUMPTION_LOG_PATH=logs/node_consumption.log
OVERALL_CONSUMPTION_LOG_PATH=logs/overall_consumption.log
NODE_OUTPUT_LOG_PATH=logs/node_output.log
TOKEN_USAGE_LOG_MAX_BYTES=10485760
TOKEN_USAGE_LOG_BACKUP_COUNT=5

ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
HF_TOKEN=your-huggingface-token-here

# Dynamics CRM leads validation (Dataverse TDS/SQL, OAuth client credentials)
CRM_LEADS_SERVER=org.crm4.dynamics.com,5558
CRM_LEADS_TABLE=dbo.lead
CRM_LEADS_MAX_RETRIES=4
CRM_LEADS_RETRY_DELAY_SECONDS=1
CRM_App_Name=your-azure-app-registration-name
CRM_Tenant_Id=your-azure-tenant-id
CRM_LEAD_CLIENT_ID=your-azure-application-client-id
CRM_Secret_ID=your-client-secret-record-id
CLIENT_SECRET=your-client-secret-value

# MPI patient lookup
MPI_API_URL=http://10.111.111.192:8090/AIAgentIntegration.Service/api/MpiOperations/GetPatientByIdentificationValue
MPI_AUTH_TOKEN=your-mpi-auth-token

# ── MPI endpoints — all 5 environments ──────────────────────────────────────
# (AIAgentIntegration.Service Endpoint Documentation.md, Sections 2–4)
# get_patient.py derives these from its ENVIRONMENTS table; the entries below
# are optional per-environment overrides (e.g. jump hosts / alternate DNS).
# AIAgentIntegration.Service (port 8090) — GetPatientByIdentificationValue
MPI_API_URL_AHJ=http://ahj-hmis:8090/AIAgentIntegration.Service/api/MpiOperations/GetPatientByIdentificationValue
MPI_API_URL_SNB=http://snb-hmisapp-01:8090/AIAgentIntegration.Service/api/MpiOperations/GetPatientByIdentificationValue
MPI_API_URL_AKW=http://akw-hmis:8090/AIAgentIntegration.Service/api/MpiOperations/GetPatientByIdentificationValue
MPI_API_URL_ALW=http://alw-hmis:8090/AIAgentIntegration.Service/api/MpiOperations/GetPatientByIdentificationValue
MPI_API_URL_ERS=http://ers-fwzhmisapp:8090/AIAgentIntegration.Service/api/MpiOperations/GetPatientByIdentificationValue
# Security Service / SercurityService (port 7000) — api/security/login
MPI_LOGIN_URL_AHJ=http://ahj-hmis:7000/SercurityService/api/security/login
MPI_LOGIN_URL_SNB=http://snb-hmisapp-01:7000/SercurityService/api/security/login
MPI_LOGIN_URL_AKW=http://akw-hmis:7000/SercurityService/api/security/login
MPI_LOGIN_URL_ALW=http://alw-hmis:7000/SercurityService/api/security/login
MPI_LOGIN_URL_ERS=http://ers-fwzhmisapp:7000/SercurityService/api/security/login
# SecurityService login credentials (Section 3)
MPI_SERVICE_USERNAME=AiModule
MPI_SERVICE_PASSWORD=123456
# Domain credentials for NTLM-authenticated login retries
MPI_NTLM_USERNAME=DOMAIN\username
MPI_NTLM_PASSWORD=your-domain-password

# ── Automated QA sampling (app/automation) ───────────────────────────────────
# Inert by default: nothing runs until QA_AUTOMATION_ENABLED=true.
QA_AUTOMATION_ENABLED=false
QA_DAILY_TARGET=300

# IANA zone name, never a fixed offset. Africa/Cairo is UTC+2 (EET) in winter
# and UTC+3 (EEST) from the last Friday of April to the last Thursday of
# October, so reporting days are 23, 24 or 25 hours long. Use Asia/Riyadh for
# KSA-only operations.
QA_REPORTING_TIMEZONE=Africa/Cairo
QA_SAMPLING_INTERVAL_MINUTES=120
QA_SOURCE_GRACE_MINUTES=20
QA_DISPATCH_INTERVAL_SECONDS=600

# Changing the seed, the policy version or the interval length changes every
# future selection. Bump QA_SAMPLING_POLICY_VERSION when any of them changes.
QA_SAMPLING_SEED=42
QA_SAMPLING_POLICY_VERSION=v1
QA_EXCLUDE_ADJACENT_CHATS=true
QA_MIN_CHAT_GAP_MINUTES=0

QA_WORKER_CONCURRENCY=1
QA_MAX_ATTEMPTS=3
QA_LEASE_DURATION_MINUTES=10

# Local SQLite ledger. We have no DDL rights on DWH, so all automation state
# (runs, quotas, intervals, candidate snapshots, jobs, result links) lives
# here. DWH is read-and-insert only — no schema change of any kind.
# Back this file up: the candidate snapshots are the selection audit trail.
QA_LEDGER_DB_PATH=data/qa_automation.sqlite3

